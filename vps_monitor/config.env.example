# YouTube 频道 ID，以 UC 开头。优先配置 API Key；留空时使用 RSS 备用方案。
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx
YOUTUBE_API_KEY=

# SMTP 示例：QQ 邮箱通常为 smtp.qq.com / 465 / ssl；密码填写 SMTP 授权码。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=your_account@qq.com
SMTP_PASSWORD=your_smtp_authorization_code
EMAIL_FROM=your_account@qq.com
EMAIL_TO=your_receive_address@example.com
